{
  "name": "webrtc",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "ci": "pnpm run format:check && pnpm run lint && moon run :build :format :typecheck :lint :test :verify",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "moon run :test --query \"projectSource~packages/*\"",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.34.9"
}
