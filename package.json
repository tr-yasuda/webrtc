{
  "name": "webrtc",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "moon run :test --query \"projectSource~packages/*\"",
    "test:integration": "pnpm --filter @webrtc/resources run test:integration",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.22.0"
}
