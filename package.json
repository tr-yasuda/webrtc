{
  "name": "webrtc",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "format": "oxfmt \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,toml}\"",
    "format:check": "pnpm run format --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "rimraf": "6.1.4",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.34.9"
}
