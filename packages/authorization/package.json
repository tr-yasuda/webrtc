{
  "name": "@webrtc/authorization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "check:traceability": "node scripts/check-traceability.mjs",
    "mutation": "stryker run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:conformance": "pnpm build && node scripts/run-authorization-conformance.mjs",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@webrtc/domain": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "fast-check": "4.11.0",
    "tsdown": "0.23.7",
    "ulid": "3.0.2",
    "vitest": "5.1.1"
  }
}
