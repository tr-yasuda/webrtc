{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.local/specs/security/contract.schema.json",
  "title": "WebRTC platform security contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tls",
    "dtls",
    "baseline",
    "secretClasses",
    "redaction",
    "outputBoundaries",
    "transportProfiles",
    "audit",
    "validationStages"
  ],
  "properties": {
    "version": { "const": 1 },
    "tls": { "$ref": "#/$defs/tls" },
    "dtls": { "$ref": "#/$defs/dtls" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "secretClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/secretClass" }
    },
    "redaction": { "$ref": "#/$defs/redaction" },
    "outputBoundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/outputBoundary" }
    },
    "transportProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/transportProfile" }
    },
    "audit": { "$ref": "#/$defs/audit" },
    "validationStages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/validationStage" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prohibitedVersions", "tls12", "tls13"],
      "properties": {
        "prohibitedVersions": { "$ref": "#/$defs/nonEmptyStrings" },
        "tls12": { "$ref": "#/$defs/tls12" },
        "tls13": { "$ref": "#/$defs/tls13" }
      }
    },
    "tls12": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minVersion",
        "keyExchange",
        "cipherKinds",
        "prohibited",
        "sessionResumption",
        "requireAuthenticationOnResumption"
      ],
      "properties": {
        "minVersion": { "const": "1.2" },
        "keyExchange": { "$ref": "#/$defs/nonEmptyStrings" },
        "cipherKinds": { "$ref": "#/$defs/nonEmptyStrings" },
        "prohibited": { "$ref": "#/$defs/nonEmptyStrings" },
        "sessionResumption": { "type": "boolean" },
        "requireAuthenticationOnResumption": { "type": "boolean" }
      }
    },
    "tls13": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minVersion",
        "keyExchange",
        "groups",
        "psk",
        "sessionResumption",
        "requireAuthenticationOnResumption",
        "zeroRtt"
      ],
      "properties": {
        "minVersion": { "const": "1.3" },
        "keyExchange": { "$ref": "#/$defs/nonEmptyStrings" },
        "groups": { "$ref": "#/$defs/nonEmptyStrings" },
        "psk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "mode",
            "externalPskRequiresExplicitConfig",
            "pskKeAllowed"
          ],
          "properties": {
            "allowed": { "type": "boolean" },
            "mode": { "const": "psk_dhe_ke" },
            "externalPskRequiresExplicitConfig": { "type": "boolean" },
            "pskKeAllowed": { "type": "boolean" }
          }
        },
        "sessionResumption": { "type": "boolean" },
        "requireAuthenticationOnResumption": { "type": "boolean" },
        "zeroRtt": { "const": false }
      }
    },
    "dtls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportedVersions",
        "preferredVersion",
        "prohibitedVersions",
        "plaintextFallback",
        "webrtcDtls12Renegotiation",
        "requireCertificateFingerprintVerification"
      ],
      "properties": {
        "supportedVersions": { "$ref": "#/$defs/nonEmptyStrings" },
        "preferredVersion": { "const": "1.3" },
        "prohibitedVersions": { "$ref": "#/$defs/nonEmptyStrings" },
        "plaintextFallback": { "const": false },
        "webrtcDtls12Renegotiation": { "const": false },
        "requireCertificateFingerprintVerification": { "const": true }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transportProfiles",
        "forbiddenFallbacks",
        "secretClasses",
        "outputBoundaries",
        "auditEventKinds",
        "validationStages",
        "tls",
        "dtls"
      ],
      "properties": {
        "transportProfiles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonEmptyStrings" }
        },
        "forbiddenFallbacks": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonEmptyStrings" }
        },
        "secretClasses": { "$ref": "#/$defs/nonEmptyStrings" },
        "outputBoundaries": { "$ref": "#/$defs/nonEmptyStrings" },
        "auditEventKinds": { "$ref": "#/$defs/nonEmptyStrings" },
        "validationStages": { "$ref": "#/$defs/nonEmptyStrings" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prohibitedVersions",
            "tls12KeyExchange",
            "tls12CipherKinds",
            "tls12Prohibited",
            "tls13KeyExchange",
            "tls13Groups",
            "zeroRtt",
            "pskMode",
            "pskKeAllowed"
          ],
          "properties": {
            "prohibitedVersions": { "$ref": "#/$defs/nonEmptyStrings" },
            "tls12KeyExchange": { "$ref": "#/$defs/nonEmptyStrings" },
            "tls12CipherKinds": { "$ref": "#/$defs/nonEmptyStrings" },
            "tls12Prohibited": { "$ref": "#/$defs/nonEmptyStrings" },
            "tls13KeyExchange": { "$ref": "#/$defs/nonEmptyStrings" },
            "tls13Groups": { "$ref": "#/$defs/nonEmptyStrings" },
            "zeroRtt": { "const": false },
            "pskMode": { "const": "psk_dhe_ke" },
            "pskKeAllowed": { "const": false }
          }
        },
        "dtls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supportedVersions",
            "preferredVersion",
            "prohibitedVersions",
            "plaintextFallback",
            "webrtcDtls12Renegotiation",
            "requireCertificateFingerprintVerification"
          ],
          "properties": {
            "supportedVersions": { "$ref": "#/$defs/nonEmptyStrings" },
            "preferredVersion": { "const": "1.3" },
            "prohibitedVersions": { "$ref": "#/$defs/nonEmptyStrings" },
            "plaintextFallback": { "const": false },
            "webrtcDtls12Renegotiation": { "const": false },
            "requireCertificateFingerprintVerification": { "const": true }
          }
        }
      }
    },
    "secretClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "examples"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "examples": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensitiveKeys", "marker", "maxDepth", "maxItems", "maxStringLength"],
      "properties": {
        "sensitiveKeys": { "$ref": "#/$defs/nonEmptyStrings" },
        "marker": { "type": "string", "minLength": 1 },
        "maxDepth": { "type": "integer", "minimum": 1 },
        "maxItems": { "type": "integer", "minimum": 1 },
        "maxStringLength": { "type": "integer", "minimum": 1 }
      }
    },
    "outputBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "allowedTypes", "forbiddenClasses", "redactionFallback"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "allowedTypes": { "$ref": "#/$defs/nonEmptyStrings" },
        "forbiddenClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "redactionFallback": { "type": "boolean" }
      }
    },
    "transportProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "requiredControls", "forbiddenFallbacks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/id" },
        "requiredControls": { "$ref": "#/$defs/nonEmptyStrings" },
        "forbiddenFallbacks": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorKinds", "eventKinds"],
      "properties": {
        "actorKinds": { "$ref": "#/$defs/nonEmptyStrings" },
        "eventKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/auditEventKind" }
        }
      }
    },
    "auditEventKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requiredFields", "fieldTypes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "requiredFields": { "$ref": "#/$defs/nonEmptyStrings" },
        "fieldTypes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/auditFieldType" }
        },
        "decisionValues": { "$ref": "#/$defs/nonEmptyStrings" },
        "resultValues": { "$ref": "#/$defs/nonEmptyStrings" },
        "stageValues": { "$ref": "#/$defs/nonEmptyStrings" },
        "outcomeValues": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "auditFieldType": {
      "enum": ["identifier", "timestamp", "actor", "target", "string", "enum", "identifier-array"]
    },
    "validationStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requiredResponsibilities"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "requiredResponsibilities": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  }
}
