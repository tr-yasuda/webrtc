{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.local/specs/security/components.schema.json",
  "title": "Security component registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "components", "exemptions"],
  "properties": {
    "version": { "const": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["pnpm", "cargo"] },
          "status": { "enum": ["required", "tooling", "exempt"] },
          "exemptionId": { "type": "string", "minLength": 1 },
          "profiles": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "outputBoundaries": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "validationStages": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "allowedOutputModules": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "allowedSecretModules": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "exemptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "owner", "expires"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "expires": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}
